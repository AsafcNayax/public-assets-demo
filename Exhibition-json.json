{
  "parent": "app_vposm.json",
  "name": "vposm",
  "assets": "vposm",
  "views": {
    "id__page_default_idle_pay": {
      "id": "id__page_default_pay",
      "views": [
        {
          "id": "id__payment_methods",
          "type": "include",
          "width": "match_parent",
          "view": "view__payment_methods",
          "center_in_parent": true
        },
        {
          "id": "id__image_1",
          "type": "image",
          "src": "https://raw.githubusercontent.com/AsafcNayax/public-assets-demo/refs/heads/main/your-logo-placeholder-ellipse.png",
          "width": "190dp",
          "height": "126dp",
          "align_parent_start": true,
          "align_parent_top": true,
          "margin_top": 20,
          "margin_right": 0,
          "margin_left": 20
        }
      ]
    },
    "view__custom_page_custom_1": {
      "id": "view__custom_page_custom_1",
      "type": "relative_layout",
      "width": "match_parent",
      "height": "match_parent",
      "views": [
        {
          "type": "lottie",
          "id": "el_2",
          "url": "https://raw.githubusercontent.com/AsafcNayax/public-assets-demo/refs/heads/main/VPOSM_Splash_Logo.json",
          "repeats": 9999999999,
          "width": "match_parent",
          "height": "match_parent",
          "loop": true,
          "center_in_parent": true
        }
      ]
    },
    "view__custom_page_custom_3": {
      "id": "view__custom_page_custom_3",
      "type": "relative_layout",
      "width": "match_parent",
      "height": "match_parent",
      "views": [
        {
          "type": "lottie",
          "id": "el_4",
          "url": "https://raw.githubusercontent.com/AsafcNayax/public-assets-demo/refs/heads/main/Crackers%203.json",
          "repeats": 9999999999,
          "width": "match_parent",
          "height": "match_parent",
          "loop": true,
          "center_in_parent": true
        }
      ]
    },
    "id__page_prod_select": {
      "id": "id__page_prod_select",
      "views": [
        {
          "type": "image",
          "center_in_parent": true,
          "src": "@assets/select_product_idle.png",
          "name": "select_product_full"
        },
        {
          "id": "id__title",
          "type": "text",
          "text": "$($(main_info):welcome_choose_prod)",
          "auto_max_lines": true,
          "style": "styles:style__title_text",
          "margin_start": 50,
          "margin_end": 50
        },
        {
          "id": "id__image_3",
          "type": "image",
          "src": "https://raw.githubusercontent.com/AsafcNayax/public-assets-demo/refs/heads/main/your-logo-placeholder-ellipse.png",
          "width": "130dp",
          "height": "86dp",
          "align_parent_start": true,
          "margin": 14,
          "margin_top": 44,
          "margin_right": 14,
          "margin_bottom": 14,
          "margin_left": 14
        }
      ]
    }
  },
  "data": {
    "custom_idle_pages": {
      "1_default_idle_0": {
        "layout": "id__page_default_idle_pay"
      },
      "2_custom_1": {
        "layout": "view__custom_page_custom_1"
      },
      "3_custom_3": {
        "layout": "view__custom_page_custom_3"
      }
    }
  },
  "screens": {
    "idle": {
      "root": {
        "views": [
          {
            "id": "id__payment_types",
            "type": "include",
            "width": "match_parent",
            "align_parent_bottom": true,
            "view": "view__payment_types"
          },
          {
            "type": "flow_layout",
            "width": "match_parent",
            "height": "match_parent",
            "center_in_parent": true,
            "provider": "data(scheme:custom_idle_pages)",
            "infinite": true,
            "auto_advance": true,
            "transition_type": "none",
            "fade_duration": 0,
            "auto_advance_delay": 9000,
            "indicator_bottom_margin": 90,
            "indicator_active_color": "@white",
            "indicator_fade_in": 300,
            "indicator_fade_out": 400,
            "user_pause_duration": 15000
          },
          {
            "id": "id__status_bar",
            "type": "include",
            "width": "match_parent",
            "align_parent_top": true,
            "view": "view__title_w_lang"
          }
        ]
      }
    }
  }
}