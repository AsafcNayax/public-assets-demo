{
  "parent": "app_vposm.json",
  "name": "vposm",
  "assets": "vposm",
  "views": {
    "view__custom_page_custom_1": {
      "id": "view__custom_page_custom_1",
      "type": "relative_layout",
      "width": "match_parent",
      "height": "match_parent",
      "views": [
        {
          "type": "video",
          "id": "el_2",
          "src": "https://github.com/AsafcNayax/public-assets-demo/raw/refs/heads/main/%5BTubePull%5D%20Lays_5_Seconds_Commercial.mp4",
          "width": "match_parent",
          "height": "match_parent",
          "repeats": 9999,
          "center_in_parent": true
        }
      ]
    },
    "view__custom_page_custom_3": {
      "id": "view__custom_page_custom_3",
      "type": "relative_layout",
      "width": "match_parent",
      "height": "match_parent",
      "views": [
        {
          "type": "lottie",
          "id": "el_4",
          "url": "https://raw.githubusercontent.com/AsafcNayax/public-assets-demo/refs/heads/main/coke_idle_480_he.min.json",
          "repeats": 9999999999,
          "width": "match_parent",
          "height": "match_parent",
          "loop": true,
          "center_in_parent": true
        }
      ]
    }
  },
  "data": {
    "custom_idle_pages": [
{
"inject": "vposm(scheme:idle_pages)"
},
      {
        "layout": "id__page_prod_select"
      },
      {
        "layout": "view__custom_page_custom_1"
      },
      {
        "layout": "view__custom_page_custom_3"
      }
    ]
  },
  "screens": {
    "idle": {
      "root": {
        "views": [
          {
            "id": "id__payment_types",
            "type": "include",
            "width": "match_parent",
            "align_parent_bottom": true,
            "view": "view__payment_types"
          },
          {
            "type": "flow_layout",
            "width": "match_parent",
            "height": "match_parent",
            "center_in_parent": true,
            "provider": "data(scheme:custom_idle_pages)",
            "infinite": true,
            "auto_advance": true,
            "transition_type": "none",
            "fade_duration": 0,
            "auto_advance_delay": 6000,
            "indicator_bottom_margin": 90,
            "indicator_active_color": "@white",
            "indicator_fade_in": 300,
            "indicator_fade_out": 400,
            "user_pause_duration": 15000
          },
          {
            "id": "id__status_bar",
            "type": "include",
            "width": "match_parent",
            "align_parent_top": true,
            "view": "view__title_w_lang"
          }
        ]
